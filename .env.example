# 任意 OpenAI 兼容接口；默认值对应 DeepSeek
BASE_URL=https://api.deepseek.com/v1
# 填入你的模型 API Key；留空则使用页面内的「连接模型」配置
API_KEY=
MODEL=deepseek-flash
PORT=8000

# openai = 真实模型；mock = 无密钥的本地流程演示
LLM_PROVIDER=openai
DATA_DIR=data
MAX_UPLOAD_MB=15
REQUEST_TIMEOUT_SECONDS=120

# 打包版首次启动会自动写入示例卡片；想关闭就取消下面这行的注释
# RECALL_CARD_SEED_DEMO=0
